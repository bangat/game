{
  "name": "insect-expedition",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server/index.cjs",
  "scripts": {
    "start": "node server/index.cjs",
    "start:firebase": "node tools/serve-firebase.cjs",
    "test": "node --test tests/server.cjs tests/battle.cjs tests/world.cjs tests/world-browser.cjs tests/progression.cjs",
    "test:browser": "node tests/browser-flow.cjs",
    "test:mobile": "node tests/landscape.cjs",
    "test:menus": "node tests/menu-http.cjs",
    "emulators": "npx --yes firebase-tools@14.16.0 emulators:start --config firebase.emulator.json --project demo-sky-tower --only auth,database",
    "build:release": "node tools/validate.cjs",
    "release": "npm run build:release && node tools/package-release.cjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
